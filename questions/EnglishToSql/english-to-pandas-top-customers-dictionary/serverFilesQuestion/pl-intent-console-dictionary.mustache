{{#question}}
<section class="pl-intent-console-dictionary" data-pl-intent-console-dictionary="{{name}}" data-intent-console-root="{{name}}" data-action-name="{{action_name}}" data-pending="{{#pending}}1{{/pending}}{{^pending}}0{{/pending}}">
  <div class="pl-intent-console-dictionary-field">
    <label class="pl-intent-console-dictionary-label" for="{{source_name}}">{{input_label}}</label>
    <textarea class="form-control pl-intent-console-dictionary-english" id="{{source_name}}" name="{{source_name}}" rows="4" placeholder="Describe the query in English…"{{^input_editable}} disabled{{/input_editable}}>{{source}}</textarea>
    {{#input_editable}}
    <div class="pl-intent-console-dictionary-actions">
      <button type="button" class="btn btn-primary btn-sm" data-intent-console-generate{{^can_generate}} disabled{{/can_generate}}>{{generate_label}}</button>
      <span class="pl-intent-console-dictionary-hint" data-intent-console-status>{{#pending}}Generating…{{/pending}}{{^pending}}Generations left: {{generations_left}}{{/pending}}</span>
    </div>
    {{/input_editable}}
  </div>

  <div class="pl-intent-console-dictionary-field">
    <label class="pl-intent-console-dictionary-label" for="{{code_name}}">{{code_label}}</label>
    <textarea class="form-control pl-intent-console-dictionary-code" id="{{code_name}}" name="{{code_name}}" rows="8" spellcheck="false" placeholder="{{code_placeholder}}"{{^code_editable}} readonly{{/code_editable}}>{{code}}</textarea>
    <p class="pl-intent-console-dictionary-hint">{{generate_label}} replaces this code. Save &amp; Grade grades the code shown.</p>
  </div>

  {{#parse_error}}
  <div class="alert alert-danger py-2" role="alert">{{parse_error}}</div>
  {{/parse_error}}

  {{#has_preview}}
  <div class="pl-intent-console-dictionary-preview">
    <div class="pl-intent-console-dictionary-preview-title">Result preview</div>
    <div class="table-responsive">
      <table class="table table-sm table-bordered mb-0">
        <thead><tr>{{#preview_columns}}<th scope="col">{{value}}</th>{{/preview_columns}}</tr></thead>
        <tbody>
          {{#preview_rows}}<tr>{{#cells}}<td>{{value}}</td>{{/cells}}</tr>{{/preview_rows}}
        </tbody>
      </table>
    </div>
  </div>
  {{/has_preview}}
</section>
{{/question}}

{{#submission}}
<section class="pl-intent-console-dictionary pl-intent-console-dictionary--submission">
  <div class="pl-intent-console-dictionary-label">English analysis plan</div>
  <div class="pl-intent-console-dictionary-submitted-source">{{source}}</div>
  <div class="pl-intent-console-dictionary-label mt-3">{{submitted_code_label}}</div>
  <pre class="pl-intent-console-dictionary-submitted-code"><code>{{code}}</code></pre>
  {{#parse_error}}<div class="alert alert-danger py-2" role="alert">{{parse_error}}</div>{{/parse_error}}
  {{#has_preview}}
  <div class="pl-intent-console-dictionary-preview">
    <div class="pl-intent-console-dictionary-preview-title">Result preview</div>
    <div class="table-responsive">
      <table class="table table-sm table-bordered mb-0">
        <thead><tr>{{#preview_columns}}<th scope="col">{{value}}</th>{{/preview_columns}}</tr></thead>
        <tbody>{{#preview_rows}}<tr>{{#cells}}<td>{{value}}</td>{{/cells}}</tr>{{/preview_rows}}</tbody>
      </table>
    </div>
  </div>
  {{/has_preview}}
</section>
{{/submission}}

{{#answer}}
<section class="pl-intent-console-dictionary pl-intent-console-dictionary--answer">
  <div class="pl-intent-console-dictionary-label">{{reference_label}}</div>
  <pre class="pl-intent-console-dictionary-submitted-code"><code>{{reference_code}}</code></pre>
</section>
{{/answer}}
